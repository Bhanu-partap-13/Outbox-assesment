generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}
model User {
  id         String   @id @default(cuid())
  googleId   String   @unique
  email      String   @unique
  name       String
  avatar     String?
  createdAt  DateTime @default(now())
  emails     Email[]
  senders    Sender[]
  campaigns  Campaign[]
  slack      SlackConnection?
  notices    RateLimitNotice[]
}
model Sender {
  id           String   @id @default(cuid())
  userId       String
  name         String
  email        String
  // Encrypted Ethereal credentials are never returned by APIs.
  smtpUser     String
  smtpSecret   String
  hourlyLimit  Int      @default(200)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails       Email[]
  campaigns    Campaign[]
  @@unique([userId, email])
}
model Campaign {
  id             String   @id @default(cuid())
  userId         String
  senderId       String
  idempotencyKey String
  requestHash    String
  delayMs        Int
  hourlyLimit    Int
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender         Sender   @relation(fields: [senderId], references: [id])
  emails         Email[]
  @@unique([userId, idempotencyKey])
}
model Email {
  id           String      @id @default(cuid())
  userId       String
  senderId     String
  campaignId   String
  sequence     Int
  to           String
  subject      String
  body         String
  scheduledAt  DateTime
  sentAt       DateTime?
  status       EmailStatus @default(SCHEDULED)
  error        String?
  attempts     Int         @default(0)
  // Durable outbox: the relay enqueues every unqueued row.
  enqueuedAt   DateTime?
  processingAt DateTime?
  previewUrl   String?
  messageId    String?
  version      Int         @default(1)
  indexedVersion Int       @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender       Sender      @relation(fields: [senderId], references: [id])
  campaign     Campaign    @relation(fields: [campaignId], references: [id])
  @@unique([campaignId, sequence])
  @@index([userId, status, scheduledAt])
  @@index([userId, sentAt])
  @@index([status, enqueuedAt])
}
model SlackConnection {
  userId         String   @id
  teamId         String
  teamName       String
  channel        String
  webhookSecret  String
  connectedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model RateLimitNotice {
  id             String   @id
  userId         String
  senderId       String
  senderEmail    String
  limit          Int
  resumesAt      DateTime
  sentAt         DateTime?
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([sentAt, nextAttemptAt])
}
